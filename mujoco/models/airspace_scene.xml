<mujoco model="airspace_paper2">
  <compiler angle="radian" coordinate="local" inertiafromgeom="false"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <worldbody>
    <light pos="10 10 15" dir="-0.5 -0.5 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="ground" type="plane" size="30 30 0.1" rgba="0.95 0.95 0.95 1"/>

    <!-- Start Marker (Blue sphere) - visual only, does not physically collide with the drone -->
    <geom name="start_marker" type="sphere" pos="0 0 0.2" size="0.3" rgba="0.1 0.2 0.9 0.8" contype="0" conaffinity="0"/>

    <!-- Target Marker (Red cone / sphere) - visual only, does not physically collide with the drone -->
    <geom name="target_marker" type="sphere" pos="20 18 2.0" size="0.3" rgba="0.9 0.1 0.1 0.8" contype="0" conaffinity="0"/>

    <!-- Scaled Obstacles from Paper 2 (Cuboids & Cylinders).
         contype/conaffinity=0: these are avoided at the PLANNING level (the
         B-spline path is routed around them), not via physics contacts -- there
         is no reactive collision-avoidance controller in this demo, so if the
         smoothed curve clips an obstacle's edge (it does, measurably, for 3 of
         these 4 -- the waypoint safety margin isn't always enough to keep the
         cubic-spline interpolation clear of the obstacle it detoured around),
         a solid collider would just physically wedge the drone against the
         building instead of letting the planned flight continue to the goal. -->
    <!-- Obstacle 1: High-rise cuboid building -->
    <geom name="obs_building1" type="box" pos="6 5 2.0" size="1.5 1.5 2.0" rgba="0.2 0.7 0.3 0.8" contype="0" conaffinity="0"/>

    <!-- Obstacle 2: Communication tower cylinder -->
    <geom name="obs_tower1" type="cylinder" pos="11 8 2.5" size="1.0 2.5" rgba="0.8 0.3 0.2 0.8" contype="0" conaffinity="0"/>

    <!-- Obstacle 3: Large cuboid building -->
    <geom name="obs_building2" type="box" pos="15 13 1.8" size="2.0 1.2 1.8" rgba="0.2 0.7 0.3 0.8" contype="0" conaffinity="0"/>

    <!-- Obstacle 4: Cylinder tower -->
    <geom name="obs_tower2" type="cylinder" pos="8 14 2.2" size="1.2 2.2" rgba="0.8 0.3 0.2 0.8" contype="0" conaffinity="0"/>

    <!-- Quadrotor body -->
    <body name="quadrotor" pos="0 0 0.2">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.5" fullinertia="6.5e-4 6.5e-4 1.2e-3 0 0 0"/>

      <geom name="core" type="sphere" size="0.08" rgba="0.1 0.4 0.9 1"/>
      <geom name="arm_x1" type="cylinder" fromto="0 0 0  0.22 0 0" size="0.015" rgba="0.9 0.2 0.2 1"/>
      <geom name="arm_x2" type="cylinder" fromto="0 0 0 -0.22 0 0" size="0.015" rgba="0.2 0.2 0.2 1"/>
      <geom name="arm_y1" type="cylinder" fromto="0 0 0 0  0.22 0" size="0.015" rgba="0.2 0.9 0.2 1"/>
      <geom name="arm_y2" type="cylinder" fromto="0 0 0 0 -0.22 0" size="0.015" rgba="0.2 0.2 0.2 1"/>

      <geom name="rotor_1" type="cylinder" pos=" 0.22  0    0.02" size="0.08 0.005" rgba="0.9 0.1 0.1 0.8"/>
      <geom name="rotor_2" type="cylinder" pos="-0.22  0    0.02" size="0.08 0.005" rgba="0.3 0.3 0.3 0.8"/>
      <geom name="rotor_3" type="cylinder" pos=" 0    0.22  0.02" size="0.08 0.005" rgba="0.1 0.9 0.1 0.8"/>
      <geom name="rotor_4" type="cylinder" pos=" 0   -0.22  0.02" size="0.08 0.005" rgba="0.3 0.3 0.3 0.8"/>
    </body>
  </worldbody>
</mujoco>
