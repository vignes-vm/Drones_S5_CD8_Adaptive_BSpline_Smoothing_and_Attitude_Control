<?xml version="1.0"?>
<model>
  <name>quadrotor</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <author>
    <name>UAV Team</name>
    <email>uav@amrita.edu</email>
  </author>
  <description>
    6-DOF Quadrotor model matching Paper 2 parameters:
    m = 1.0 kg, Ixx = Iyy = 6.5e-4 kg*m^2, Izz = 1.2e-3 kg*m^2, arm length d = 0.23 m.
  </description>
</model>
